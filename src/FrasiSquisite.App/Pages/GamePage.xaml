<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FrasiSquisite.App.ViewModels"
             xmlns:services="clr-namespace:FrasiSquisite.App.Services"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             x:Class="FrasiSquisite.App.Pages.GamePage"
             x:Name="RootPage"
             x:DataType="vm:GameSessionViewModel"
             Shell.NavBarIsVisible="False"
             Title="Frasi Squisite">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="{Binding ErrorText}" TextColor="OrangeRed"
                   IsVisible="{Binding ErrorText, Converter={StaticResource NotEmpty}}" />

            <Label Text="{Binding ConnectionBanner}" TextColor="OrangeRed"
                   IsVisible="{Binding ConnectionBanner, Converter={StaticResource NotEmpty}}" />

            <!-- ================= Home ================= -->
            <VerticalStackLayout Spacing="20" IsVisible="{Binding Screen, Converter={StaticResource IsScreen}, ConverterParameter=Home}">

                <Label Text="&#9881;&#65039;" FontSize="22" HorizontalOptions="End">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenSettingsCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <VerticalStackLayout Spacing="12" Margin="0,24">
                    <Label Text="Gioco da tavolo, ma sul telefono" Style="{StaticResource EyebrowLabel}" HorizontalOptions="Center" />
                    <Label Text="Frasi Squisite" Style="{StaticResource H1Label}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    <Label Style="{StaticResource BodyLabel}" HorizontalOptions="Center" HorizontalTextAlignment="Center"
                           Text="Riempi una casella. Non guardare le altre. Ridi delle conseguenze." />
                </VerticalStackLayout>

                <!-- Discreto: il mockup dà il nickname per già impostato altrove,
                     noi non abbiamo quell'altrove, quindi resta qui un campo
                     minimo invece di un'intera schermata di onboarding. -->
                <Entry Placeholder="Il tuo nome" Text="{Binding Nickname}"
                       FontSize="13" HorizontalTextAlignment="Center" />

                <!-- Stato iniziale -->
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsJoiningByCode}" Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </VerticalStackLayout.Triggers>
                    <Button Text="Crea una stanza" Style="{StaticResource PrimaryButton}" Command="{Binding CreateRoomCommand}" />
                    <Button Text="Ho un codice" Style="{StaticResource SecondaryButton}" Command="{Binding ShowJoinByCodeCommand}" />
                </VerticalStackLayout>

                <!-- "Ho un codice": sostituisce i due pulsanti sopra -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsJoiningByCode}">
                    <Border Style="{StaticResource CodeEntryFrame}">
                        <Entry Style="{StaticResource CodeEntryText}" Placeholder="CODICE STANZA" MaxLength="4"
                               Text="{Binding JoinCode, Converter={StaticResource Uppercase}}" />
                    </Border>
                    <Button Text="Entra" Style="{StaticResource PrimaryButton}" Command="{Binding JoinRoomCommand}" />
                    <Button Text="Indietro" Style="{StaticResource SecondaryButton}" Command="{Binding HideJoinByCodeCommand}" />
                </VerticalStackLayout>

                <Label Style="{StaticResource FootnoteLabel}" IsVisible="{Binding Nickname, Converter={StaticResource NotEmpty}}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Il tuo nickname: " />
                            <Span Text="{Binding Nickname}" FontAttributes="Bold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

            </VerticalStackLayout>

            <!-- ================= Impostazioni ================= -->
            <VerticalStackLayout Spacing="20" IsVisible="{Binding Screen, Converter={StaticResource IsScreen}, ConverterParameter=Settings}">

                <Label Text="← Indietro" Style="{StaticResource H3Label}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CloseSettingsCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Text="Impostazioni" Style="{StaticResource H2Label}" />

                <VerticalStackLayout Spacing="10">
                    <Label Text="Aspetto" Style="{StaticResource H3Label}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding SelectedTheme, Converter={StaticResource IsTheme}, ConverterParameter=SurrealistaPop}"
                                             Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource ThemeAccentBrush}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectThemeCommand}"
                                                       CommandParameter="{x:Static services:ThemeChoice.SurrealistaPop}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="8">
                                <BoxView Color="#FAF6EF" HeightRequest="48" />
                                <Label Text="Chiaro" Style="{StaticResource H3Label}" />
                                <Label Text="Surrealista Pop" Style="{StaticResource FootnoteLabel}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding SelectedTheme, Converter={StaticResource IsTheme}, ConverterParameter=NotteDiGioco}"
                                             Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource ThemeAccentBrush}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectThemeCommand}"
                                                       CommandParameter="{x:Static services:ThemeChoice.NotteDiGioco}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="8">
                                <BoxView Color="#0D0D12" HeightRequest="48" />
                                <Label Text="Scuro" Style="{StaticResource H3Label}" />
                                <Label Text="Notte di Gioco" Style="{StaticResource FootnoteLabel}" />
                            </VerticalStackLayout>
                        </Border>

                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Server" Style="{StaticResource H3Label}" />
                    <Entry Text="{Binding ServerUrl}" Placeholder="Indirizzo del server" />
                    <Label Text="Inserisci l'indirizzo del computer che ospita la partita."
                           Style="{StaticResource FootnoteLabel}" HorizontalOptions="Start" HorizontalTextAlignment="Start" />
                </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- ================= Lobby ================= -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding Screen, Converter={StaticResource IsScreen}, ConverterParameter=Lobby}">

                <Label Text="Stanza" Style="{StaticResource EyebrowLabel}" HorizontalOptions="Center" />
                <Label Text="{Binding RoomCode}" Style="{StaticResource RoomCodeLabel}" />

                <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Border WidthRequest="80" HeightRequest="80" StrokeThickness="1" StrokeDashArray="4,4"
                            BackgroundColor="{DynamicResource ThemeSurfaceAlt}"
                            Stroke="{DynamicResource ThemeInk33Brush}"
                            StrokeShape="{DynamicResource ThemeRadiusSoftShape}">
                        <Label Text="QR / codice" Style="{StaticResource FootnoteLabel}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <!-- Chi non è host legge solo il nome dello schema scelto: un
                         controllo qui darebbe NOT_HOST al tocco (lotto-c-brief.md). -->
                    <Label Text="{Binding SchemaSummary}" Style="{StaticResource BodyLabel}" VerticalOptions="Center"
                           IsVisible="{Binding CanChangeSchema, Converter={StaticResource InvertBool}}" />
                </HorizontalStackLayout>

                <!-- Selettore schema, solo per l'host: stessa idea del selettore di
                     tema in Impostazioni (Border "Chip" con TapGestureRecognizer),
                     con il bordo d'accento sulla voce selezionata al posto di una
                     Picker nativa. Il conteggio delle caselle di ogni voce viene
                     da SchemaOptionView.SlotCount (a sua volta dallo SchemaView di
                     rete), mai scritto a mano: schemi diversi hanno lunghezze
                     diverse ed è il punto di questo lotto. -->
                <CollectionView ItemsSource="{Binding SchemaOptions}" IsVisible="{Binding CanChangeSchema}"
                                HorizontalOptions="Center">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SchemaOptionView">
                            <Border Style="{StaticResource Chip}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Stroke" Value="{DynamicResource ThemeAccentBrush}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.SelectSchemaCommand}"
                                        CommandParameter="{Binding Id}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Nome}" Style="{StaticResource ChipLabel}" />
                                    <Label Style="{StaticResource FootnoteLabel}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding SlotCount}" />
                                                <Span Text=" caselle" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding PlayerCount, StringFormat='Giocatori ({0})'}" Style="{StaticResource H3Label}" />

                <CollectionView ItemsSource="{Binding Players}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlayerRowView">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12" Padding="0,6">

                                <!-- Riga normale: avatar, nome, badge "host" se presente.
                                     Nascosta durante la modifica del bot, sostituita dal
                                     campo di testo sotto. -->
                                <Border Grid.Column="0" Style="{StaticResource Avatar}"
                                        IsVisible="{Binding IsEditing, Converter={StaticResource InvertBool}}">
                                    <Label Text="{Binding Nickname, Converter={StaticResource Initial}}" Style="{StaticResource AvatarInitial}" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Nickname}" Style="{StaticResource H3Label}" VerticalOptions="Center"
                                       IsVisible="{Binding IsEditing, Converter={StaticResource InvertBool}}" />
                                <Border Grid.Column="2" Style="{StaticResource Chip}" IsVisible="{Binding IsHost}" VerticalOptions="Center">
                                    <Label Text="host" Style="{StaticResource ChipLabel}" />
                                </Border>

                                <!-- Bot, non in modifica: matita (rinomina) e ✕ (rimuovi).
                                     Mai visibili per un giocatore umano. -->
                                <Label Grid.Column="3" Text="✏" FontSize="16" VerticalOptions="Center"
                                       IsVisible="{Binding ShowBotControls}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.StartEditBotCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Grid.Column="4" Text="✕" FontSize="16" VerticalOptions="Center"
                                       IsVisible="{Binding ShowBotControls}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.RemoveBotCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>

                                <!-- Bot in modifica: campo di testo, ✓ (conferma), ✕ (annulla).
                                     MaxLength duplica NicknameValidator.MaxLength (FrasiSquisite.Shared):
                                     XAML non può referenziare quella costante, va tenuto allineato
                                     manualmente all'originale (lotto-b-brief.md), come già fa
                                     GameSessionViewModel.MaxPlayers per GameEngine.MaxPlayers. -->
                                <Entry Grid.Column="0" Grid.ColumnSpan="3" MaxLength="20"
                                       IsVisible="{Binding IsEditing}"
                                       Text="{Binding Source={x:Reference RootPage}, Path=BindingContext.EditingBotName}" />
                                <Label Grid.Column="3" Text="✓" FontSize="16" VerticalOptions="Center"
                                       IsVisible="{Binding IsEditing}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.ConfirmEditBotCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Grid.Column="4" Text="✕" FontSize="16" VerticalOptions="Center"
                                       IsVisible="{Binding IsEditing}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.CancelEditBotCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="+ Aggiungi bot" Style="{StaticResource SecondaryButton}"
                        Command="{Binding AddBotCommand}" IsVisible="{Binding CanAddBot}" />

                <Button Text="Inizia partita" Style="{StaticResource PrimaryButton}"
                        Command="{Binding StartGameCommand}" IsVisible="{Binding IsHost}" />

            </VerticalStackLayout>

            <!-- ================= Scrittura ================= -->
            <VerticalStackLayout Spacing="20" IsVisible="{Binding Screen, Converter={StaticResource IsScreen}, ConverterParameter=Writing}">

                <Label Style="{StaticResource BodyLabel}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Round " />
                            <Span Text="{Binding Round}" />
                            <Span Text=" di " />
                            <Span Text="{Binding TotalRounds}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding Ruolo}" Style="{StaticResource EyebrowLabel}" HorizontalOptions="Center" />
                    <Label Text="{Binding Prompt}" Style="{StaticResource H2Label}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    <Label Style="{StaticResource ExampleLabel}" HorizontalOptions="Center" HorizontalTextAlignment="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Es. " />
                                <Span Text="{Binding Esempio}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Border Style="{StaticResource SlotEditorFrame}">
                        <Editor Style="{StaticResource SlotEditorText}" Placeholder="Scrivi qui" Text="{Binding SlotText}" MaxLength="60" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Button Text="Invia" Style="{StaticResource PrimaryButton}" Command="{Binding SubmitSlotCommand}"
                            IsEnabled="{Binding SlotText, Converter={StaticResource NotEmpty}}" />
                    <Label Text="Le altre caselle restano segrete. Anche da te stesso, fra un minuto."
                           Style="{StaticResource FootnoteLabel}" />
                </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- ================= Attesa ================= -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding Screen, Converter={StaticResource IsScreen}, ConverterParameter=Waiting}">
                <ActivityIndicator IsRunning="True" Color="{DynamicResource ThemeAccent}" HorizontalOptions="Center" />
                <Label Text="In attesa…" Style="{StaticResource H2Label}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Label Style="{StaticResource BodyLabel}" HorizontalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding SubmittedCount}" />
                            <Span Text=" di " />
                            <Span Text="{Binding PlayerCount}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>

            <!-- ================= Reveal ================= -->
            <VerticalStackLayout Spacing="20" IsVisible="{Binding Screen, Converter={StaticResource IsScreen}, ConverterParameter=Reveal}">

                <Label Style="{StaticResource BodyLabel}" HorizontalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Frase " />
                            <Span Text="{Binding PhraseNumber}" />
                            <Span Text=" di " />
                            <Span Text="{Binding TotalPhrases}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <FlexLayout Wrap="Wrap" JustifyContent="Center" AlignItems="Center"
                            BindableLayout.ItemsSource="{Binding RevealSlots}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:RevealSlotView">
                            <!-- Due Border alternativi (invece di uno con trigger)
                                 perché "coperta" ha un bordo tratteggiato e
                                 "rivelata" uno pieno: sovrascrivere lo
                                 StrokeDashArray a runtime è più fragile che
                                 scegliere fra due stili già corretti. -->
                            <Grid>
                                <Border Margin="4" Style="{StaticResource RevealSlotRevealedFrame}"
                                        IsVisible="{Binding IsRevealed}">
                                    <Label Text="{Binding Text}" Style="{StaticResource RevealSlotRevealedText}" />
                                </Border>
                                <Border Margin="4" Style="{StaticResource RevealSlotCoveredFrame}"
                                        IsVisible="{Binding IsRevealed, Converter={StaticResource InvertBool}}">
                                    <Label Text="{Binding Text}" Style="{StaticResource RevealSlotCoveredText}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Label Text="{Binding AuthorsFootnote}" Style="{StaticResource FootnoteLabel}"
                       IsVisible="{Binding AuthorsFootnote, Converter={StaticResource NotEmpty}}" />

                <Button Text="{Binding RevealButtonLabel}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AdvanceRevealCommand}" IsVisible="{Binding IsHost}" />

            </VerticalStackLayout>

            <!-- ================= Fine ================= -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding Screen, Converter={StaticResource IsScreen}, ConverterParameter=Finished}">

                <Label Text="Ecco cosa è venuto fuori" Style="{StaticResource EyebrowLabel}" HorizontalOptions="Center" />

                <CollectionView ItemsSource="{Binding FinalPhrases}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="sys:String">
                            <Border Style="{StaticResource Card}" Margin="0,8">
                                <Label Text="{Binding .}" Style="{StaticResource H1WinnerLabel}" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Solo l'host vede questi due pulsanti (lotto-d-brief.md):
                     un pulsante che risponde NOT_HOST al tocco è peggio di un
                     pulsante assente, stessa idea del selettore di schema e
                     dei controlli dei bot. Chi non è host legge l'avviso
                     discreto sotto invece. -->
                <Button Text="Nuova partita" Style="{StaticResource PrimaryButton}"
                        Command="{Binding NewGameCommand}" IsVisible="{Binding ShowFinishedActions}" />
                <Button Text="Torna alla lobby" Style="{StaticResource SecondaryButton}"
                        Command="{Binding BackToLobbyCommand}" IsVisible="{Binding ShowFinishedActions}" />
                <Label Text="Tocca all'host decidere come continuare." Style="{StaticResource FootnoteLabel}"
                       HorizontalOptions="Center"
                       IsVisible="{Binding ShowFinishedActions, Converter={StaticResource InvertBool}}" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
