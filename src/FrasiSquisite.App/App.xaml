<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FrasiSquisite.App"
             xmlns:converters="clr-namespace:FrasiSquisite.App.Converters"
             x:Class="FrasiSquisite.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:IsScreenConverter x:Key="IsScreen" />
            <converters:NotEmptyConverter x:Key="NotEmpty" />
            <converters:IsThemeConverter x:Key="IsTheme" />
            <converters:InvertedBoolConverter x:Key="InvertBool" />
            <converters:UppercaseConverter x:Key="Uppercase" />
            <converters:InitialConverter x:Key="Initial" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
